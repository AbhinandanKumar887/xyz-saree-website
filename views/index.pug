extends demo.pug
block style
  style
    include ../static/style.css
    include ../static/home.css

block content
  //- ── Hero Slider ──────────────────────────────────────
  section#hero
    .hero-slide.active
    .hero-slide
    .hero-slide
    .hero-slide
    .hero-overlay
      h1 Welcome to SARASWATI Saree Centre
      p Wrap Yourself in Colors of Heritage
      .hero-cta
        a.btn-primary(href="#moto") Explore Collections
    .hero-dots
      span.hero-dot.active(data-index="0")
      span.hero-dot(data-index="1")
      span.hero-dot(data-index="2")
      span.hero-dot(data-index="3")

  //- ── Tagline Strip ────────────────────────────────────
  section#promo
    span Our Thoughts
    .moto1
      .card.reveal
        img(src="/static/saare1.jpg" alt="Heritage Saree")
        p Where Tradition Meets Trend.
      .card.reveal
        img(src="/static/saare2.webp" alt="Artistic Saree")
        p Saree: The Art of Subtlety.
      .card.reveal
        img(src="/static/saare3.webp" alt="Elegant Saree")
        p Drape the Difference.

  //- ── Collections ──────────────────────────────────────
  section#moto
    p Our Collections
    .container
      a.col-card.reveal(href="/handloom")
        img(src="/static/hand.webp" alt="Handloom Sarees")
        span Handloom Sarees
      a.col-card.reveal(href="/traditional")
        img(src="/static/tra.jpg" alt="Traditional Sarees")
        span Traditional Sarees
      a.col-card.reveal(href="/bridal")
        img(src="/static/bri.jpg" alt="Bridal Collection")
        span Bridal Collection

  //- ── Flash Message ────────────────────────────────────
  if message
    .flash-msg= message
