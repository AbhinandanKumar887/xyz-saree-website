extends demo.pug
block style
  style
    include ../static/style.css
    include ../static/contact.css

block content
  .contact-hero
    h1 Contact Us
    p We'd love to hear from you

  .contact-wrap
    .contact-info.reveal
      h2 Visit Us
      p 123, Silk Market Road, Varanasi, UP — 221001
      p
        strong Phone:
        |  +91 98765 43210
      p
        strong Email:
        |  hello@xyz-saareecenter.com
      p
        strong Hours:
        |  Mon–Sat, 10 AM – 8 PM

    .contact-form-box.reveal
      h2 Send a Message
      form#abhi(action="/contact" method="post")
        input.text(type="text" name="nam" placeholder="Your Name" required)
        input.text(type="text" name="locality" placeholder="Your Locality / City" required)
        input.text(type="text" name="ambition" placeholder="Your Saree Choice / Enquiry")
        input.text(type="tel" name="mobile" placeholder="Mobile Number" required)
        button.btn(type="submit") Send Message ✉

      if message
        .form-msg= message
